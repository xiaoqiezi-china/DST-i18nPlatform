<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DstMcI18n</RootNamespace>
    <AssemblyName>DST-MC-I18n-Tool</AssemblyName>
    <Version>1.1.0</Version>
    <Product>DST MC I18n Tool</Product>
    <AssemblyTitle>DST MC I18n Tool</AssemblyTitle>

    <!-- 自包含发布：目标机器无需安装 .NET 运行时。
         不做单文件打包、不做自解压：发布目录就是普通的 exe + 依赖 dll，
         启动时不会往临时目录解压任何东西，也不会触发“自解压程序”类的杀软误报。 -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>

    <!-- 不生成 IIS 用的 web.config / 静态资源清单 -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- 测试工程是独立项目，不要被主项目编译进去 -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <Content Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

  <!-- 前端资源全部内嵌进程序集（wwwroot 目录不需要随包分发） -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot/**/*" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Remove="wwwroot/**/*" />
  </ItemGroup>

</Project>
