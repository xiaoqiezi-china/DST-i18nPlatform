<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DstMcI18n.ExportHarness</RootNamespace>
    <AssemblyName>ExportHarness</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Link the production sources so the harness tests the real code, not a copy. -->
    <Compile Include="../../src/Core/*.cs" />
    <Compile Include="../../src/Services/Exporters.cs" />
  </ItemGroup>

</Project>
